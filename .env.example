# Copy to .env only if you do not already have one. Keep real secrets out of Git.
# app/core/config.py requires DATABASE_URL and JWT_SECRET (or SECRET_KEY).
POSTGRES_USER=gapcode
POSTGRES_PASSWORD=gapcode_dev_password
POSTGRES_DB=gapcode
DATABASE_URL=postgresql+asyncpg://gapcode:gapcode_dev_password@db:5432/gapcode
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-random-secret-before-starting
BACKEND_PORT=8000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
SMS_PROVIDER=mock
